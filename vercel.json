{
  "routes": [
    { "src": "/(.*)", "continue": true, "headers": { "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'", "X-Frame-Options": "DENY", "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" } },
    { "src": "/_vercel/(.*)", "dest": "/_vercel/$1" },
    { "src": "/", "has": [{ "type": "host", "value": "memoriox.eu" }], "dest": "/landing/index.html" },
    { "src": "/", "has": [{ "type": "host", "value": "www.memoriox.eu" }], "dest": "/landing/index.html" },
    { "src": "/(.*)", "has": [{ "type": "host", "value": "memoriox.eu" }], "dest": "/landing/$1" },
    { "src": "/(.*)", "has": [{ "type": "host", "value": "www.memoriox.eu" }], "dest": "/landing/$1" },
    { "handle": "filesystem" }
  ]
}
